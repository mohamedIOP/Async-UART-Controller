module RX_deserializer_test_1 ( clk, ARSTn, deser_en, sampled_bit, edge_cnt, 
        Prescale, P_DATA, test_si, test_so, test_se );
  input [4:0] edge_cnt;
  input [5:0] Prescale;
  output [7:0] P_DATA;
  input clk, ARSTn, deser_en, sampled_bit, test_si, test_se;
  output test_so;
  wire   N1, n1, n11, n13, n15, n17, n19, n21, n23, n25, n2, n3, n4, n5, n6,
         n7, n8, n9, n26, n27, n28, n29, n30, n31, n32, n33;
  assign test_so = n27;

  SDFFRQX2M \P_DATA_reg[0]  ( .D(n11), .SI(test_si), .SE(test_se), .CK(clk), 
        .RN(ARSTn), .Q(P_DATA[0]) );
  SDFFRQX2M \P_DATA_reg[5]  ( .D(n21), .SI(n30), .SE(test_se), .CK(clk), .RN(
        ARSTn), .Q(P_DATA[5]) );
