module mux_1 ( in0, in1, sel, out );
  input in0, in1, sel;
  output out;
  wire   N0;
  assign N0 = sel;

  MX2X6M U1 ( .A(in0), .B(in1), .S0(N0), .Y(out) );
endmodule


