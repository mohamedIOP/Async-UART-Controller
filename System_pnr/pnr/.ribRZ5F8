module FIFO_TOP_DATA_WIDTH8_MEM_DEPTH8_test_1 ( W_CLK, W_RST, W_INC, R_CLK, 
        R_RST, R_INC, WR_DATA, FULL, EMPTY, RD_DATA, test_si2, test_si1, 
        test_so2, test_so1, test_se );
  input [7:0] WR_DATA;
  output [7:0] RD_DATA;
  input W_CLK, W_RST, W_INC, R_CLK, R_RST, R_INC, test_si2, test_si1, test_se;
  output FULL, EMPTY, test_so2, test_so1;
  wire   _0_net_, n1, n2;
  wire   [3:0] RQ2_W_PTR;
  wire   [3:0] R_PTR;
  wire   [2:0] R_ADDR;
  wire   [3:0] WQ2_R_PTR;
  wire   [3:0] W_PTR;
  wire   [2:0] W_ADDR;
  assign test_so1 = R_ADDR[2];

  NOR2BX2M U1 ( .AN(W_INC), .B(FULL), .Y(_0_net_) );
  INVX2M U2 ( .A(n2), .Y(n1) );
  INVX2M U3 ( .A(W_RST), .Y(n2) );
  FIFO_RD_test_1 M0 ( .R_EN(R_INC), .R_RST_n(R_RST), .R_CLK(R_CLK), 
        .RQ2_W_PTR(RQ2_W_PTR), .R_EMPTY(EMPTY), .R_PTR(R_PTR), .R_ADDR(R_ADDR), 
        .test_si2(test_si2), .test_si1(test_si1), .test_se(test_se) );
  SYNC_test_0 M1_R ( .CLK(W_CLK), .IN(R_PTR), .RST(n1), .OUT(WQ2_R_PTR), 
        .test_se(test_se) );
  SYNC_test_1 M2_W ( .CLK(R_CLK), .IN(W_PTR), .RST(R_RST), .OUT(RQ2_W_PTR), 
        .test_si(WQ2_R_PTR[3]), .test_se(test_se) );
  FIFO_WR_test_1 M3 ( .W_EN(W_INC), .W_RST_n(n1), .W_CLK(W_CLK), .WQ2_R_PTR(
        WQ2_R_PTR), .W_FULL(FULL), .W_PTR(W_PTR), .W_ADDR(W_ADDR), .test_si(
        RQ2_W_PTR[3]), .test_se(test_se) );
  FIFO_RAM_test_1 M4 ( .W_CLK(W_CLK), .W_CLK_EN(_0_net_), .W_RST_n(n1), 
        .W_DATA(WR_DATA), .W_ADDR(W_ADDR), .R_ADDR(R_ADDR), .R_DATA(RD_DATA), 
        .test_si(W_PTR[3]), .test_so(test_so2), .test_se(test_se) );
endmodule


