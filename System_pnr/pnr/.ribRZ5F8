  mux_0 rst1_mux ( .in0(rst_n), .in1(scan_rst), .sel(n11), .out(RESET_SCAN) );
  mux_6 rst2_mux ( .in0(UART_SYNC_RST), .in1(scan_rst), .sel(n11), .out(
