module TX_FSM_test_1 ( clk, ARSTn, DATA_VALID, PAR_EN, serial_done, mux_sel, 
        busy, serial_en, cs_out, test_si, test_se );
  output [1:0] mux_sel;
  output [2:0] cs_out;
  input clk, ARSTn, DATA_VALID, PAR_EN, serial_done, test_si, test_se;
  output busy, serial_en;
  wire   n7, n8, n9, n10, n11, n4, n5, n6;
  wire   [2:0] ns;

  SDFFRQX2M \cs_reg[0]  ( .D(ns[0]), .SI(test_si), .SE(test_se), .CK(clk), 
        .RN(ARSTn), .Q(cs_out[0]) );
  SDFFRQX2M \cs_reg[1]  ( .D(ns[1]), .SI(cs_out[0]), .SE(test_se), .CK(clk), 
        .RN(ARSTn), .Q(cs_out[1]) );
  SDFFRQX2M \cs_reg[2]  ( .D(ns[2]), .SI(n5), .SE(test_se), .CK(clk), .RN(
        ARSTn), .Q(cs_out[2]) );
  NAND2X2M U6 ( .A(n8), .B(n10), .Y(busy) );
  NAND2BX2M U7 ( .AN(serial_en), .B(n9), .Y(ns[0]) );
  NAND3X2M U8 ( .A(n5), .B(n6), .C(DATA_VALID), .Y(n9) );
  AOI21X2M U9 ( .A0(cs_out[1]), .A1(serial_done), .B0(n8), .Y(serial_en) );
  NOR3X2M U10 ( .A(n5), .B(cs_out[2]), .C(n7), .Y(ns[2]) );
  AOI2B1X1M U11 ( .A1N(PAR_EN), .A0(serial_done), .B0(n4), .Y(n7) );
  NAND2X2M U12 ( .A(cs_out[0]), .B(n6), .Y(n8) );
  NAND2X2M U13 ( .A(cs_out[1]), .B(n4), .Y(n10) );
  OAI21X2M U14 ( .A0(cs_out[2]), .A1(n5), .B0(n8), .Y(ns[1]) );
  INVX2M U15 ( .A(cs_out[1]), .Y(n5) );
  INVX2M U16 ( .A(cs_out[2]), .Y(n6) );
  INVX2M U17 ( .A(cs_out[0]), .Y(n4) );
  OAI21X2M U18 ( .A0(cs_out[2]), .A1(cs_out[0]), .B0(n10), .Y(mux_sel[1]) );
  OAI21BX1M U19 ( .A0(n5), .A1(n8), .B0N(n11), .Y(mux_sel[0]) );
  OAI32X1M U20 ( .A0(cs_out[1]), .A1(cs_out[2]), .A2(cs_out[0]), .B0(n6), .B1(
        n10), .Y(n11) );
endmodule


module TX_mux ( one, zero, parity, data_s, mux_sel, mux_out );
  input [1:0] mux_sel;
  input one, zero, parity, data_s;
  output mux_out;
  wire   n2, n3, n1;

  INVX2M U1 ( .A(mux_sel[0]), .Y(n1) );
  OAI2B2X4M U2 ( .A1N(mux_sel[1]), .A0(n2), .B0(mux_sel[1]), .B1(n3), .Y(
        mux_out) );
  AOI22X1M U3 ( .A0(mux_sel[0]), .A1(data_s), .B0(zero), .B1(n1), .Y(n3) );
  AOI22X1M U4 ( .A0(parity), .A1(n1), .B0(one), .B1(mux_sel[0]), .Y(n2) );
endmodule


module TX_PARITY ( DATA, PAR_TYP, DATA_VALID, PAR_EN, parity );
  input [7:0] DATA;
  input PAR_TYP, DATA_VALID, PAR_EN;
  output parity;
  wire   n1, n2, n3, n4, n5;

  XNOR2X2M U2 ( .A(DATA[3]), .B(DATA[2]), .Y(n4) );
  XNOR2X2M U3 ( .A(DATA[7]), .B(DATA[6]), .Y(n5) );
  AND2X2M U4 ( .A(PAR_EN), .B(n1), .Y(parity) );
  XOR3XLM U5 ( .A(PAR_TYP), .B(n2), .C(n3), .Y(n1) );
  XOR3XLM U6 ( .A(DATA[5]), .B(DATA[4]), .C(n5), .Y(n2) );
  XOR3XLM U7 ( .A(DATA[1]), .B(DATA[0]), .C(n4), .Y(n3) );
endmodule


module TX_Serializer_test_1 ( clk, ARSTn, DATA, ser_en, ser_done, ser_data, 
        test_si, test_so, test_se );
  input [7:0] DATA;
  input clk, ARSTn, ser_en, test_si, test_se;
  output ser_done, ser_data, test_so;
  wire   N3, N4, N5, N17, N18, N19, n4, n5, n6, n8, n9;
  assign test_so = N5;

  SDFFSQX2M \counter_reg[1]  ( .D(N18), .SI(N3), .SE(test_se), .CK(clk), .SN(
        ARSTn), .Q(N4) );
  SDFFSQX2M \counter_reg[0]  ( .D(N17), .SI(test_si), .SE(test_se), .CK(clk), 
        .SN(ARSTn), .Q(N3) );
  SDFFSQX1M \counter_reg[2]  ( .D(N19), .SI(N4), .SE(test_se), .CK(clk), .SN(
        ARSTn), .Q(N5) );
  NOR2BX2M U7 ( .AN(N5), .B(n4), .Y(ser_done) );
  NAND2X2M U8 ( .A(N4), .B(N3), .Y(n4) );
  NAND2X2M U9 ( .A(ser_en), .B(N3), .Y(N17) );
  NAND2X2M U10 ( .A(n5), .B(ser_en), .Y(N19) );
  CLKXOR2X2M U11 ( .A(n4), .B(N5), .Y(n5) );
  NAND2X2M U12 ( .A(n6), .B(ser_en), .Y(N18) );
  XNOR2X2M U13 ( .A(N4), .B(N3), .Y(n6) );
  MX2X2M U14 ( .A(n9), .B(n8), .S0(N5), .Y(ser_data) );
  MX4X1M U15 ( .A(DATA[4]), .B(DATA[5]), .C(DATA[6]), .D(DATA[7]), .S0(N3), 
        .S1(N4), .Y(n8) );
  MX4X1M U16 ( .A(DATA[0]), .B(DATA[1]), .C(DATA[2]), .D(DATA[3]), .S0(N3), 
        .S1(N4), .Y(n9) );
endmodule


module TX_TOP_DATA_WIDTH8_test_1 ( CLK, RST, PAR_EN, PAR_TYP, P_DATA, 
        DATA_VALID, S_DATA, BUSY, test_si, test_so, test_se );
  input [7:0] P_DATA;
  input CLK, RST, PAR_EN, PAR_TYP, DATA_VALID, test_si, test_se;
  output S_DATA, BUSY, test_so;
  wire   N4, N5, N6, N7, N8, N9, N10, N11, serial_done, serial_en, parity,
         data_s, n10, n11, n9, n12, n16, n17;
  wire   [7:0] TEMPO;
  wire   [2:0] cs;
  wire   [1:0] mux_sel;

  SDFFRQX2M \TEMPO_reg[5]  ( .D(N9), .SI(TEMPO[4]), .SE(n17), .CK(CLK), .RN(
        RST), .Q(TEMPO[5]) );
  SDFFRQX2M \TEMPO_reg[1]  ( .D(N5), .SI(TEMPO[0]), .SE(n17), .CK(CLK), .RN(
        RST), .Q(TEMPO[1]) );
  SDFFRQX2M \TEMPO_reg[0]  ( .D(N4), .SI(test_si), .SE(n17), .CK(CLK), .RN(RST), .Q(TEMPO[0]) );
  SDFFRQX2M \TEMPO_reg[4]  ( .D(N8), .SI(TEMPO[3]), .SE(n17), .CK(CLK), .RN(
        RST), .Q(TEMPO[4]) );
  SDFFRQX2M \TEMPO_reg[3]  ( .D(N7), .SI(TEMPO[2]), .SE(n17), .CK(CLK), .RN(
        RST), .Q(TEMPO[3]) );
  SDFFRQX2M \TEMPO_reg[7]  ( .D(N11), .SI(TEMPO[6]), .SE(n17), .CK(CLK), .RN(
        RST), .Q(TEMPO[7]) );
  SDFFRQX2M \TEMPO_reg[2]  ( .D(N6), .SI(TEMPO[1]), .SE(n17), .CK(CLK), .RN(
        RST), .Q(TEMPO[2]) );
  SDFFRQX2M \TEMPO_reg[6]  ( .D(N10), .SI(TEMPO[5]), .SE(n17), .CK(CLK), .RN(
        RST), .Q(TEMPO[6]) );
  INVX2M U11 ( .A(n9), .Y(n12) );
  BUFX2M U12 ( .A(n10), .Y(n9) );
  NAND3BX2M U13 ( .AN(cs[0]), .B(DATA_VALID), .C(n11), .Y(n10) );
  NOR2X2M U14 ( .A(cs[2]), .B(cs[1]), .Y(n11) );
  AO22X1M U15 ( .A0(P_DATA[6]), .A1(n12), .B0(TEMPO[6]), .B1(n9), .Y(N10) );
  AO22X1M U16 ( .A0(P_DATA[7]), .A1(n12), .B0(TEMPO[7]), .B1(n9), .Y(N11) );
  AO22X1M U17 ( .A0(P_DATA[1]), .A1(n12), .B0(TEMPO[1]), .B1(n9), .Y(N5) );
  AO22X1M U18 ( .A0(P_DATA[2]), .A1(n12), .B0(TEMPO[2]), .B1(n9), .Y(N6) );
  AO22X1M U19 ( .A0(P_DATA[3]), .A1(n12), .B0(TEMPO[3]), .B1(n9), .Y(N7) );
  AO22X1M U20 ( .A0(P_DATA[4]), .A1(n12), .B0(TEMPO[4]), .B1(n9), .Y(N8) );
  AO22X1M U21 ( .A0(P_DATA[5]), .A1(n12), .B0(TEMPO[5]), .B1(n9), .Y(N9) );
  AO22X1M U22 ( .A0(P_DATA[0]), .A1(n12), .B0(TEMPO[0]), .B1(n9), .Y(N4) );
  INVXLM U23 ( .A(test_se), .Y(n16) );
  INVXLM U24 ( .A(n16), .Y(n17) );
  TX_FSM_test_1 V1 ( .clk(CLK), .ARSTn(RST), .DATA_VALID(DATA_VALID), .PAR_EN(
        PAR_EN), .serial_done(serial_done), .mux_sel(mux_sel), .busy(BUSY), 
        .serial_en(serial_en), .cs_out(cs), .test_si(TEMPO[7]), .test_se(n17)
         );
  TX_mux V2 ( .one(1'b1), .zero(1'b0), .parity(parity), .data_s(data_s), 
        .mux_sel(mux_sel), .mux_out(S_DATA) );
  TX_PARITY V3 ( .DATA(TEMPO), .PAR_TYP(PAR_TYP), .DATA_VALID(DATA_VALID), 
        .PAR_EN(PAR_EN), .parity(parity) );
  TX_Serializer_test_1 V4 ( .clk(CLK), .ARSTn(RST), .DATA(TEMPO), .ser_en(
        serial_en), .ser_done(serial_done), .ser_data(data_s), .test_si(cs[2]), 
        .test_so(test_so), .test_se(n17) );
endmodule


module RX_data_sampling_test_1 ( clk, ARSTn, data_samp_en, edge_cnt, RX_IN, 
        prescale, sampled_bit, test_si, test_so, test_se );
  input [4:0] edge_cnt;
  input [5:0] prescale;
  input clk, ARSTn, data_samp_en, RX_IN, test_si, test_se;
  output sampled_bit, test_so;
  wire   N6, N7, N8, n17, n18, n19, n20, n21, n22, n23, \add_15/carry[5] ,
         \add_15/carry[4] , \add_15/carry[3] , \add_15/carry[2] , n1, n2, n3,
         n4, n5, n6, n7, n8, n12, n13, n14, n15, n16, n24, n25, n26, n27, n28,
         n29, n30, n31, n32, n33, n34, n35, n36, n37, n38, n39, n40, n41, n42,
         n43, n44, n45, n46, n47;
  wire   [5:0] half;
  wire   [5:0] pre_half;
  wire   [5:0] post_half;
  wire   [2:0] samples;
  assign test_so = n46;

  SDFFRQX2M \samples_reg[1]  ( .D(n22), .SI(n47), .SE(test_se), .CK(clk), .RN(
        ARSTn), .Q(samples[1]) );
  SDFFRQX2M \samples_reg[2]  ( .D(n21), .SI(samples[1]), .SE(test_se), .CK(clk), .RN(ARSTn), .Q(samples[2]) );
  SDFFRQX2M \samples_reg[0]  ( .D(n23), .SI(test_si), .SE(test_se), .CK(clk), 
        .RN(ARSTn), .Q(samples[0]) );
  INVX2M U4 ( .A(data_samp_en), .Y(n43) );
  INVX2M U5 ( .A(N6), .Y(n44) );
  INVX2M U6 ( .A(half[3]), .Y(n8) );
  OR2X2M U7 ( .A(half[1]), .B(half[0]), .Y(n4) );
  ADDHX1M U10 ( .A(half[3]), .B(\add_15/carry[3] ), .CO(\add_15/carry[4] ), 
        .S(post_half[3]) );
  ADDHX1M U11 ( .A(half[1]), .B(half[0]), .CO(\add_15/carry[2] ), .S(
        post_half[1]) );
  ADDHX1M U12 ( .A(half[2]), .B(\add_15/carry[2] ), .CO(\add_15/carry[3] ), 
        .S(post_half[2]) );
  ADDHX1M U13 ( .A(half[4]), .B(\add_15/carry[4] ), .CO(\add_15/carry[5] ), 
        .S(post_half[4]) );
  OAI32X1M U14 ( .A0(n43), .A1(N6), .A2(n47), .B0(n19), .B1(n44), .Y(n23) );
  INVX2M U15 ( .A(samples[0]), .Y(n47) );
  OAI32X1M U16 ( .A0(n43), .A1(n18), .A2(n46), .B0(n45), .B1(n19), .Y(n21) );
  INVX2M U17 ( .A(samples[2]), .Y(n46) );
  INVX2M U18 ( .A(n18), .Y(n45) );
  NOR3BX2M U19 ( .AN(N8), .B(N7), .C(N6), .Y(n18) );
  OAI2BB2X1M U20 ( .B0(n20), .B1(n19), .A0N(samples[1]), .A1N(n20), .Y(n22) );
  AOI21X2M U21 ( .A0(n44), .A1(N7), .B0(n43), .Y(n20) );
  OR2X2M U22 ( .A(prescale[2]), .B(prescale[1]), .Y(n1) );
  NAND2X2M U23 ( .A(data_samp_en), .B(RX_IN), .Y(n19) );
  OAI2BB1X2M U24 ( .A0N(samples[0]), .A1N(samples[1]), .B0(n17), .Y(
        sampled_bit) );
  OAI21X2M U25 ( .A0(samples[0]), .A1(samples[1]), .B0(samples[2]), .Y(n17) );
  CLKINVX1M U26 ( .A(prescale[1]), .Y(half[0]) );
  OAI2BB1X1M U27 ( .A0N(prescale[1]), .A1N(prescale[2]), .B0(n1), .Y(half[1])
         );
  OR2X1M U28 ( .A(n1), .B(prescale[3]), .Y(n2) );
  OAI2BB1X1M U29 ( .A0N(n1), .A1N(prescale[3]), .B0(n2), .Y(half[2]) );
  XNOR2X1M U30 ( .A(prescale[4]), .B(n2), .Y(half[3]) );
  NOR3X1M U31 ( .A(prescale[4]), .B(prescale[5]), .C(n2), .Y(half[5]) );
  OAI21X1M U32 ( .A0(prescale[4]), .A1(n2), .B0(prescale[5]), .Y(n3) );
  NAND2BX1M U33 ( .AN(half[5]), .B(n3), .Y(half[4]) );
  OAI2BB1X1M U34 ( .A0N(half[0]), .A1N(half[1]), .B0(n4), .Y(pre_half[1]) );
  NOR2X1M U35 ( .A(n4), .B(half[2]), .Y(n5) );
  AO21XLM U36 ( .A0(n4), .A1(half[2]), .B0(n5), .Y(pre_half[2]) );
  CLKNAND2X2M U37 ( .A(n5), .B(n8), .Y(n6) );
  OAI21X1M U38 ( .A0(n5), .A1(n8), .B0(n6), .Y(pre_half[3]) );
  XNOR2X1M U39 ( .A(half[4]), .B(n6), .Y(pre_half[4]) );
  NOR2X1M U40 ( .A(half[4]), .B(n6), .Y(n7) );
  CLKXOR2X2M U41 ( .A(half[5]), .B(n7), .Y(pre_half[5]) );
  CLKXOR2X2M U42 ( .A(\add_15/carry[5] ), .B(half[5]), .Y(post_half[5]) );
  NOR2BX1M U43 ( .AN(prescale[1]), .B(edge_cnt[0]), .Y(n12) );
  OAI2B2X1M U44 ( .A1N(edge_cnt[1]), .A0(n12), .B0(pre_half[1]), .B1(n12), .Y(
        n15) );
  NOR2BX1M U45 ( .AN(edge_cnt[0]), .B(prescale[1]), .Y(n13) );
  OAI2B2X1M U46 ( .A1N(pre_half[1]), .A0(n13), .B0(edge_cnt[1]), .B1(n13), .Y(
        n14) );
  NAND3BX1M U47 ( .AN(pre_half[5]), .B(n15), .C(n14), .Y(n26) );
  CLKXOR2X2M U48 ( .A(pre_half[4]), .B(edge_cnt[4]), .Y(n25) );
  CLKXOR2X2M U49 ( .A(pre_half[2]), .B(edge_cnt[2]), .Y(n24) );
  CLKXOR2X2M U50 ( .A(pre_half[3]), .B(edge_cnt[3]), .Y(n16) );
  NOR4X1M U51 ( .A(n26), .B(n25), .C(n24), .D(n16), .Y(N6) );
  NOR2BX1M U52 ( .AN(half[0]), .B(edge_cnt[0]), .Y(n27) );
  OAI2B2X1M U53 ( .A1N(edge_cnt[1]), .A0(n27), .B0(half[1]), .B1(n27), .Y(n30)
         );
  NOR2BX1M U54 ( .AN(edge_cnt[0]), .B(half[0]), .Y(n28) );
  OAI2B2X1M U55 ( .A1N(half[1]), .A0(n28), .B0(edge_cnt[1]), .B1(n28), .Y(n29)
         );
  NAND3BX1M U56 ( .AN(half[5]), .B(n30), .C(n29), .Y(n34) );
  CLKXOR2X2M U57 ( .A(half[4]), .B(edge_cnt[4]), .Y(n33) );
  CLKXOR2X2M U58 ( .A(half[2]), .B(edge_cnt[2]), .Y(n32) );
  CLKXOR2X2M U59 ( .A(half[3]), .B(edge_cnt[3]), .Y(n31) );
  NOR4X1M U60 ( .A(n34), .B(n33), .C(n32), .D(n31), .Y(N7) );
  NOR2BX1M U61 ( .AN(prescale[1]), .B(edge_cnt[0]), .Y(n35) );
  OAI2B2X1M U62 ( .A1N(edge_cnt[1]), .A0(n35), .B0(post_half[1]), .B1(n35), 
        .Y(n38) );
  NOR2BX1M U63 ( .AN(edge_cnt[0]), .B(prescale[1]), .Y(n36) );
  OAI2B2X1M U64 ( .A1N(post_half[1]), .A0(n36), .B0(edge_cnt[1]), .B1(n36), 
        .Y(n37) );
  NAND3BX1M U65 ( .AN(post_half[5]), .B(n38), .C(n37), .Y(n42) );
  CLKXOR2X2M U66 ( .A(post_half[4]), .B(edge_cnt[4]), .Y(n41) );
  CLKXOR2X2M U67 ( .A(post_half[2]), .B(edge_cnt[2]), .Y(n40) );
  CLKXOR2X2M U68 ( .A(post_half[3]), .B(edge_cnt[3]), .Y(n39) );
  NOR4X1M U69 ( .A(n42), .B(n41), .C(n40), .D(n39), .Y(N8) );
