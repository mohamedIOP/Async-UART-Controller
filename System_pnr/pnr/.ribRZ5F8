  REG_FILE_test_1 U5 ( .CLK(CLOCK_SCAN_ref), .rst_n(n14), .ADDRESS({
        REGFILE_ADDRESS[3:2], n13, n12}), .WrEn(REGFILE_WrEn), .RdEn(
