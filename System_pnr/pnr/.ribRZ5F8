  INVXLM U3 ( .A(STP_ERR), .Y(n8) );
  INVXLM U4 ( .A(n8), .Y(n9) );
  RX_data_sampling_test_1 M0 ( .clk(CLK), .ARSTn(n1), .data_samp_en(
        dat_samp_en), .edge_cnt(edge_cnt), .RX_IN(RX_IN), .prescale(Prescale), 
        .sampled_bit(sampled_bit), .test_si(test_si1), .test_so(n4), .test_se(
        test_se) );
  RX_deserializer_test_1 M1 ( .clk(CLK), .ARSTn(n1), .deser_en(deser_en), 
        .sampled_bit(sampled_bit), .edge_cnt(edge_cnt), .Prescale(Prescale), 
        .P_DATA(P_DATA), .test_si(n4), .test_so(n3), .test_se(test_se) );
  RX_edge_counter_test_1 M2 ( .clk(CLK), .ARSTn(n1), .enable(enable), .PAR_EN(
        PAR_EN), .Prescale(Prescale), .edge_cnt(edge_cnt), .bit_cnt(bit_cnt), 
        .test_si(n3), .test_se(test_se) );
  RX_FSM_test_1 M3 ( .clk(CLK), .ARSTn(n1), .RX_IN(RX_IN), .PAR_EN(PAR_EN), 
        .par_err(PAR_ERR), .strt_glitch(strt_glitch), .stp_err(n9), .bit_cnt(
        bit_cnt), .edge_cnt(edge_cnt), .Prescale(Prescale), .dat_samp_en(
        dat_samp_en), .enable(enable), .deser_en(deser_en), .data_valid(
        Data_valid), .stp_chk_en(stp_chk_en), .strt_chk_en(strt_chk_en), 
        .par_chk_en(par_chk_en), .PAR_STALL(PAR_STALL), .test_se(test_se) );
  RX_parity_check_test_1 M4 ( .par_chk_en(par_chk_en), .sampled_bit(
        sampled_bit), .PAR_TYP(PAR_TYP), .P_DATA(P_DATA), .clk(CLK), .ARST_n(
        n1), .edge_cnt(edge_cnt), .Prescale(Prescale), .PAR_STALL(PAR_STALL), 
        .par_err(PAR_ERR), .test_si(Data_valid), .test_se(test_se) );
  RX_stop_chk_test_1 M5 ( .stp_chk_en(stp_chk_en), .sampled_bit(sampled_bit), 
        .edge_cnt(edge_cnt), .Prescale(Prescale), .clk(CLK), .ARST_n(n1), 
        .stp_err(STP_ERR), .test_si(test_si2), .test_se(test_se) );
  RX_start_chk_test_1 M6 ( .sampled_bit(sampled_bit), .strt_chk_en(strt_chk_en), .edge_cnt(edge_cnt), .Prescale(Prescale), .ARSTn(n1), .clk(CLK), 
        .strt_glitch(strt_glitch), .test_si(PAR_ERR), .test_se(test_se) );
